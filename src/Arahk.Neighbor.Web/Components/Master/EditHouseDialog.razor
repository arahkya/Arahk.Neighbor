@inject HouseService Houses

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@ThaiCopy.T("houses.edit.title")</MudText>
    </TitleContent>
    <DialogContent>
        <p class="nb-dialog-subtitle">@ThaiCopy.T("houses.edit.subtitle")</p>
        <MudForm @ref="_form">
            <MudTextField @bind-Value="_houseNo"
                          Label="@ThaiCopy.T("houses.edit.field.house_no")"
                          Placeholder="@ThaiCopy.T("houses.edit.placeholder.house_no")"
                          HelperText="@ThaiCopy.T("houses.edit.helper.house_no")"
                          Required="true"
                          RequiredError="@ThaiCopy.T("houses.error.house_no_required")"
                          MaxLength="32"
                          Immediate="true"
                          Error="@(!string.IsNullOrEmpty(_houseNoError))"
                          ErrorText="@_houseNoError"
                          Class="nb-dialog-field"
                          Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_soi"
                          Label="@ThaiCopy.T("houses.edit.field.soi_optional")"
                          Placeholder="@ThaiCopy.T("houses.edit.placeholder.soi")"
                          MaxLength="100"
                          Immediate="true"
                          Error="@(!string.IsNullOrEmpty(_soiError))"
                          ErrorText="@_soiError"
                          Class="nb-dialog-field"
                          Variant="Variant.Outlined" />
        </MudForm>
        @if (!string.IsNullOrEmpty(_formError))
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="nb-dialog-alert">@_formError</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Disabled="_busy" OnClick="Cancel">@ThaiCopy.T("houses.action.cancel")</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy" OnClick="SaveAsync">
            @ThaiCopy.T("houses.action.save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid HouseId { get; set; }
    [Parameter] public string HouseNo { get; set; } = string.Empty;
    [Parameter] public string? Soi { get; set; }

    private MudForm _form = default!;
    private string? _houseNo;
    private string? _soi;
    private string? _houseNoError;
    private string? _soiError;
    private string? _formError;
    private bool _busy;

    protected override void OnInitialized()
    {
        _houseNo = HouseNo;
        _soi = Soi;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        _houseNoError = null;
        _soiError = null;
        _formError = null;
        await _form.ValidateAsync();

        _busy = true;
        try
        {
            var result = await Houses.UpdateAsync(
                HouseConstants.DefaultCommunityId,
                new UpdateHouseRequest(HouseId, _houseNo, _soi));

            if (result.Succeeded)
            {
                MudDialog.Close(DialogResult.Ok(true));
                return;
            }

            if (result.FieldErrors.TryGetValue("houseNo", out var noErr))
                _houseNoError = FormatFieldError(noErr);
            if (result.FieldErrors.TryGetValue("soi", out var soiErr))
                _soiError = FormatFieldError(soiErr);
            if (!string.IsNullOrEmpty(result.ErrorKey))
                _formError = ThaiCopy.T(result.ErrorKey);
            if (string.IsNullOrEmpty(_houseNoError) && string.IsNullOrEmpty(_soiError) && string.IsNullOrEmpty(_formError))
                _formError = ThaiCopy.T(ErrorKeys.HouseServer);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string FormatFieldError(string key)
    {
        if (key == ErrorKeys.HouseNoTooLong)
            return ThaiCopy.Format(key, ("max", HouseConstants.HouseNoMaxLength));
        if (key == ErrorKeys.SoiTooLong)
            return ThaiCopy.Format(key, ("max", HouseConstants.SoiMaxLength));
        return ThaiCopy.T(key);
    }
}
