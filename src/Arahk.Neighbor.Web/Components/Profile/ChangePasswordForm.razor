@using Arahk.Neighbor.Domain.Services

<MudForm>
    <MudTextField @bind-Value="CurrentPassword"
                  Label="@ThaiCopy.T("password_change.field.current")"
                  InputType="InputType.Password"
                  Immediate="true"
                  Error="@(!string.IsNullOrEmpty(CurrentPasswordError))"
                  ErrorText="@CurrentPasswordError"
                  Class="nb-dialog-field"
                  Variant="Variant.Outlined"
                  autocomplete="current-password" />

    <MudTextField @bind-Value="NewPassword"
                  Label="@ThaiCopy.T("password_change.field.new")"
                  HelperText="@ThaiCopy.T("password_change.helper.complexity")"
                  InputType="InputType.Password"
                  Immediate="true"
                  Error="@(!string.IsNullOrEmpty(NewPasswordError))"
                  ErrorText="@NewPasswordError"
                  Class="nb-dialog-field"
                  Variant="Variant.Outlined"
                  autocomplete="new-password" />

    <MudTextField @bind-Value="ConfirmPassword"
                  Label="@ThaiCopy.T("password_change.field.confirm")"
                  InputType="InputType.Password"
                  Immediate="true"
                  Error="@(!string.IsNullOrEmpty(ConfirmPasswordError))"
                  ErrorText="@ConfirmPasswordError"
                  Class="nb-dialog-field"
                  Variant="Variant.Outlined"
                  autocomplete="new-password" />
</MudForm>

@code {
    public string CurrentPassword { get; set; } = string.Empty;
    public string NewPassword { get; set; } = string.Empty;
    public string ConfirmPassword { get; set; } = string.Empty;

    public string? CurrentPasswordError { get; private set; }
    public string? NewPasswordError { get; private set; }
    public string? ConfirmPasswordError { get; private set; }

    public bool ValidateClient()
    {
        CurrentPasswordError = AuthFieldRules.ValidateCurrentPassword(CurrentPassword) is { } ck
            ? ThaiCopy.T(ck) : null;
        NewPasswordError = AuthFieldRules.ValidateNewPassword(NewPassword) is { } nk
            ? ThaiCopy.T(nk) : null;
        ConfirmPasswordError = AuthFieldRules.ValidatePasswordConfirm(NewPassword, ConfirmPassword) is { } cf
            ? ThaiCopy.T(cf) : null;
        return CurrentPasswordError is null && NewPasswordError is null && ConfirmPasswordError is null;
    }

    public void ApplyServerErrors(IReadOnlyDictionary<string, string> fieldErrors)
    {
        if (fieldErrors.TryGetValue("currentPassword", out var cur))
            CurrentPasswordError = ThaiCopy.T(cur);
        if (fieldErrors.TryGetValue("newPassword", out var neu))
            NewPasswordError = ThaiCopy.T(neu);
        if (fieldErrors.TryGetValue("newPasswordConfirm", out var conf))
            ConfirmPasswordError = ThaiCopy.T(conf);
    }
}
