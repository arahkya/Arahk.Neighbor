@inherits LayoutComponentBase
@implements IBrowserViewportObserver
@implements IAsyncDisposable
@using Arahk.Neighbor.Domain.Services
@using Arahk.Neighbor.Web.Components.Profile
@using Arahk.Neighbor.Web.Theme
@using MudBlazor.Services
@inject AuthSessionState Session
@inject AppShellState Shell
@inject ProfileService Profiles
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IBrowserViewportService BrowserViewport

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="nb-app-layout">
    <MudAppBar Elevation="0" Dense="true" Class="nb-appbar" Fixed="true">
        @if (_isBelowMd)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Menu"
                           Color="Color.Inherit"
                           Edge="Edge.Start"
                           Class="nb-appbar-menu"
                           aria-label="@ThaiCopy.T("layout.nav.menu_toggle_aria")"
                           OnClick="ToggleDrawer" />
        }
        <MudText Typo="Typo.h6" Class="nb-appbar-wordmark">@ThaiCopy.T("app.wordmark")</MudText>
        <MudSpacer />
        @if (Session.IsAuthenticated)
        {
            <MudMenu AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     Class="nb-account-menu"
                     Dense="true">
                <ActivatorContent>
                    <MudAvatar Class="nb-appbar-avatar"
                               Color="Color.Primary"
                               Size="Size.Medium"
                               aria-label="@ThaiCopy.Format("profile.menu.aria", ("displayName", Session.DisplayName ?? ""))">
                        @AvatarInitials
                    </MudAvatar>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Filled.Person"
                                 OnClick="OpenProfileAsync">
                        @ThaiCopy.T("profile.menu.my_profile")
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.VpnKey"
                                 OnClick="OpenChangePasswordAsync">
                        @ThaiCopy.T("profile.menu.change_password")
                    </MudMenuItem>
                    <MudDivider Class="nb-account-menu-divider" />
                    <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                                 Class="nb-account-menu-signout"
                                 OnClick="SignOut">
                        @ThaiCopy.T("profile.menu.sign_out")
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        }
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Responsive"
               ClipMode="@DrawerClip"
               Breakpoint="Breakpoint.Md"
               Elevation="@(_isBelowMd ? 2 : 0)"
               Width="var(--nb-size-drawer-width)"
               Class="nb-drawer"
               Overlay="true"
               OverlayAutoClose="true">
        @* Desktop Persistent: wordmark only in Top Bar (no duplicate). Mobile Temporary may keep branding. *@
        @if (_isBelowMd)
        {
            <MudDrawerHeader Class="nb-drawer-header">
                <div>
                    <MudText Class="nb-drawer-wordmark">@ThaiCopy.T("app.wordmark")</MudText>
                    <MudText Class="nb-drawer-tagline">@ThaiCopy.T("app.tagline")</MudText>
                </div>
            </MudDrawerHeader>
        }
        else
        {
            <div class="nb-drawer-section">@ThaiCopy.T("nav.section")</div>
        }

        <MudNavMenu Class="nb-nav-menu" aria-label="@ThaiCopy.T("a11y.main_nav")">
            <MudNavLink Href="/"
                        Match="NavLinkMatch.All"
                        Class="nb-nav-link"
                        OnClick="OnHomeNav">
                @ThaiCopy.T("nav.home")
            </MudNavLink>
            <MudNavLink Class="nb-nav-link"
                        OnClick="@(() => OnComingSoon(ThaiCopy.T("nav.payment")))">
                @ThaiCopy.T("nav.payment")
            </MudNavLink>
            <MudNavLink Class="nb-nav-link"
                        OnClick="@(() => OnComingSoon(ThaiCopy.T("nav.packages")))">
                @ThaiCopy.T("nav.packages")
            </MudNavLink>
            <MudNavLink Class="nb-nav-link"
                        OnClick="@(() => OnComingSoon(ThaiCopy.T("nav.visitor")))">
                @ThaiCopy.T("nav.visitor")
            </MudNavLink>
            <MudNavLink Href="/master"
                        Match="NavLinkMatch.Prefix"
                        Class="nb-nav-link"
                        OnClick="OnMasterNav">
                @ThaiCopy.T("nav.master_data")
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="nb-main">
        <div class="nb-main-inner">
            @if (Shell.HasSoftSoon)
            {
                <div role="status">
                    <MudAlert Severity="Severity.Info"
                              Variant="Variant.Outlined"
                              Class="nb-alert-soon">
                        <div class="nb-alert-soon-body">
                            <strong class="nb-alert-soon-title">@ThaiCopy.T("soon.title")</strong>
                            <p class="nb-alert-soon-text">
                                @ThaiCopy.Format("soon.body_named", ("navLabel", Shell.SoftSoonNavLabel!))
                                — @ThaiCopy.T("soon.body_reassure")
                            </p>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Class="nb-alert-soon-cta"
                                       OnClick="ClearSoftSoon">
                                @ThaiCopy.T("soon.cta_home")
                            </MudButton>
                        </div>
                    </MudAlert>
                </div>
            }
            @Body
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = NeighborTheme.Create();
    private bool _drawerOpen;
    private bool _isBelowMd = true;
    private Guid _observerId = Guid.NewGuid();

    private DrawerClipMode DrawerClip =>
        _isBelowMd ? DrawerClipMode.Never : DrawerClipMode.Docked;

    private string AvatarInitials =>
        DisplayNameInitials.FromDisplayName(Session.DisplayName);

    Guid IBrowserViewportObserver.Id => _observerId;

    ResizeOptions? IBrowserViewportObserver.ResizeOptions => null;

    protected override void OnInitialized()
    {
        Shell.Changed += OnShellChanged;
        Session.Changed += OnSessionChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await BrowserViewport.SubscribeAsync(this, fireImmediately: true);
    }

    async Task IBrowserViewportObserver.NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs args)
    {
        // Temporary &lt; md · Persistent ≥ md
        var belowMd = !await BrowserViewport.IsBreakpointWithinWindowSizeAsync(Breakpoint.MdAndUp);
        ApplyBelowMd(belowMd);
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyBelowMd(bool belowMd)
    {
        var wasBelow = _isBelowMd;
        _isBelowMd = belowMd;

        if (!_isBelowMd)
            _drawerOpen = true;
        else if (!wasBelow)
            _drawerOpen = false;
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void OnHomeNav()
    {
        Shell.ClearComingSoon();
        CloseDrawerIfMobile();
    }

    private void OnMasterNav()
    {
        Shell.ClearComingSoon();
        CloseDrawerIfMobile();
    }

    private void OnComingSoon(string navLabel)
    {
        Shell.ShowComingSoon(navLabel);
        CloseDrawerIfMobile();
    }

    private void ClearSoftSoon() => Shell.ClearComingSoon();

    private void CloseDrawerIfMobile()
    {
        if (_isBelowMd)
            _drawerOpen = false;
    }

    private async Task OpenProfileAsync()
    {
        if (_isBelowMd)
        {
            Nav.NavigateTo("/profile");
            return;
        }

        var (name, email, phone) = await LoadProfileFieldsAsync();
        var parameters = new DialogParameters<ProfileEditDialog>
        {
            { x => x.InitialDisplayName, name },
            { x => x.InitialEmail, email },
            { x => x.InitialPhone, phone }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<ProfileEditDialog>(ThaiCopy.T("profile.title"), parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is string action && action == "change-password")
            await OpenChangePasswordAsync();
    }

    private async Task OpenChangePasswordAsync()
    {
        if (_isBelowMd)
        {
            Nav.NavigateTo("/profile/password");
            return;
        }

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<ChangePasswordDialog>(ThaiCopy.T("password_change.title"), options);
    }

    private async Task<(string Name, string Email, string? Phone)> LoadProfileFieldsAsync()
    {
        var name = Session.DisplayName ?? string.Empty;
        var email = Session.Email ?? string.Empty;
        string? phone = null;

        if (Session.UserId is not null)
        {
            var result = await Profiles.GetAsync(Session.UserId.Value);
            if (result.Succeeded && result.Data is not null)
            {
                name = result.Data.DisplayName;
                email = result.Data.Email;
                phone = result.Data.PhoneLocal;
            }
        }

        return (name, email, phone);
    }

    private void SignOut()
    {
        Session.SignOut();
        Shell.ClearComingSoon();
        Nav.NavigateTo("/login");
    }

    private void OnShellChanged() => InvokeAsync(StateHasChanged);
    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Shell.Changed -= OnShellChanged;
        Session.Changed -= OnSessionChanged;
        try
        {
            await BrowserViewport.UnsubscribeAsync(this);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (ObjectDisposedException)
        {
        }
    }
}
