@page "/profile/password"
@layout AppLayout
@rendermode InteractiveServer
@using Arahk.Neighbor.Web.Components.Profile
@inject AuthSessionState Session
@inject ProfileService Profiles
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@if (!Session.IsAuthenticated)
{
    <p class="nb-loading">@ThaiCopy.T("state.loading")</p>
}
else
{
    <section class="nb-profile-page" aria-labelledby="pwd-page-title">
        <div class="nb-profile-page-bar">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Class="nb-profile-back"
                           aria-label="@ThaiCopy.T("profile.back.aria")"
                           OnClick="GoBack" />
            <MudText Typo="Typo.h6" id="pwd-page-title" Class="nb-profile-page-title">
                @ThaiCopy.T("password_change.title")
            </MudText>
        </div>

        <MudPaper Class="nb-profile-page-card" Elevation="0">
            <p class="nb-dialog-subtitle">@ThaiCopy.T("password_change.subtitle")</p>
            <ChangePasswordForm @ref="_form" />
            @if (!string.IsNullOrEmpty(_formError))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="nb-dialog-alert">@_formError</MudAlert>
            }
            <div class="nb-profile-page-actions">
                <MudButton Variant="Variant.Outlined" FullWidth="true" Disabled="_busy" OnClick="GoBack" Class="nb-profile-cancel">
                    @ThaiCopy.T("password_change.action.cancel")
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_busy" OnClick="SaveAsync" Class="nb-profile-save">
                    @ThaiCopy.T("password_change.action.save")
                </MudButton>
            </div>
        </MudPaper>
    </section>
}

@code {
    private ChangePasswordForm? _form;
    private string? _formError;
    private bool _busy;

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
            Nav.NavigateTo("/login");
    }

    private void GoBack()
    {
        if (Nav.Uri.Contains("/profile/password", StringComparison.OrdinalIgnoreCase))
            Nav.NavigateTo("/profile");
        else
            Nav.NavigateTo("/");
    }

    private async Task SaveAsync()
    {
        if (Session.UserId is null || _form is null)
            return;

        _formError = null;
        if (!_form.ValidateClient())
            return;

        _busy = true;
        try
        {
            var result = await Profiles.ChangePasswordAsync(
                Session.UserId.Value,
                new ChangePasswordRequest(_form.CurrentPassword, _form.NewPassword, _form.ConfirmPassword));

            if (result.Succeeded)
            {
                Snackbar.Add(ThaiCopy.T("password_change.toast.saved"), Severity.Success);
                Nav.NavigateTo("/");
                return;
            }

            _form.ApplyServerErrors(result.FieldErrors);
            if (!string.IsNullOrEmpty(result.ErrorKey))
                _formError = ThaiCopy.T(result.ErrorKey);
            if (string.IsNullOrEmpty(_formError) && result.FieldErrors.Count == 0)
                _formError = ThaiCopy.T(ErrorKeys.ServerGeneric);
        }
        finally
        {
            _busy = false;
        }
    }
}
