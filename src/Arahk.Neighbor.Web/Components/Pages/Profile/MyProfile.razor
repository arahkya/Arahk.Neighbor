@page "/profile"
@layout AppLayout
@rendermode InteractiveServer
@using Arahk.Neighbor.Web.Components.Profile
@inject AuthSessionState Session
@inject ProfileService Profiles
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@if (!Session.IsAuthenticated)
{
    <p class="nb-loading">@ThaiCopy.T("state.loading")</p>
}
else if (_loading)
{
    <p class="nb-loading">@ThaiCopy.T("state.loading")</p>
}
else
{
    <section class="nb-profile-page" aria-labelledby="profile-page-title">
        <div class="nb-profile-page-bar">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           Class="nb-profile-back"
                           aria-label="@ThaiCopy.T("profile.back.aria")"
                           OnClick="GoBack" />
            <MudText Typo="Typo.h6" id="profile-page-title" Class="nb-profile-page-title">
                @ThaiCopy.T("profile.title")
            </MudText>
        </div>

        <MudPaper Class="nb-profile-page-card" Elevation="0">
            <p class="nb-dialog-subtitle">@ThaiCopy.T("profile.subtitle_mobile")</p>
            <ProfileEditForm @ref="_form"
                             InitialDisplayName="@_displayName"
                             InitialEmail="@_email"
                             InitialPhone="@_phone"
                             CompactHints="true"
                             OnRequestChangePassword="GoChangePassword" />
            @if (!string.IsNullOrEmpty(_formError))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="nb-dialog-alert">@_formError</MudAlert>
            }
            <div class="nb-profile-page-actions">
                <MudButton Variant="Variant.Outlined" FullWidth="true" Disabled="_busy" OnClick="GoBack" Class="nb-profile-cancel">
                    @ThaiCopy.T("profile.action.cancel")
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_busy" OnClick="SaveAsync" Class="nb-profile-save">
                    @ThaiCopy.T("profile.action.save")
                </MudButton>
            </div>
        </MudPaper>
    </section>
}

@code {
    private ProfileEditForm? _form;
    private string _displayName = string.Empty;
    private string _email = string.Empty;
    private string? _phone;
    private string? _formError;
    private bool _busy;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || Session.UserId is null)
        {
            Nav.NavigateTo("/login");
            return;
        }

        var result = await Profiles.GetAsync(Session.UserId.Value);
        if (result.Succeeded && result.Data is not null)
        {
            _displayName = result.Data.DisplayName;
            _email = result.Data.Email;
            _phone = result.Data.PhoneLocal;
        }
        else
        {
            _displayName = Session.DisplayName ?? string.Empty;
            _email = Session.Email ?? string.Empty;
        }

        _loading = false;
    }

    private void GoBack() => Nav.NavigateTo("/");

    private void GoChangePassword() => Nav.NavigateTo("/profile/password");

    private async Task SaveAsync()
    {
        if (Session.UserId is null || _form is null)
            return;

        _formError = null;
        if (!_form.ValidateClient())
            return;

        _busy = true;
        try
        {
            var result = await Profiles.UpdateAsync(
                Session.UserId.Value,
                new UpdateProfileRequest(_form.DisplayName, _form.Phone));

            if (result.Succeeded && result.Data is not null)
            {
                Session.UpdateDisplayName(result.Data.DisplayName);
                Snackbar.Add(ThaiCopy.T("profile.toast.saved"), Severity.Success);
                Nav.NavigateTo("/");
                return;
            }

            _form.ApplyServerErrors(result.FieldErrors);
            if (!string.IsNullOrEmpty(result.ErrorKey))
                _formError = ThaiCopy.T(result.ErrorKey);
            if (string.IsNullOrEmpty(_formError) && result.FieldErrors.Count == 0)
                _formError = ThaiCopy.T(ErrorKeys.ServerGeneric);
        }
        finally
        {
            _busy = false;
        }
    }
}
