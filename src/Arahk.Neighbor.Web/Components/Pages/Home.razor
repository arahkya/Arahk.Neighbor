@page "/"
@layout AppLayout
@rendermode InteractiveServer
@inject AuthSessionState Session
@inject NavigationManager Nav

@if (!Session.IsAuthenticated)
{
    <p class="nb-loading">@ThaiCopy.T("state.loading")</p>
}
else
{
    <section class="nb-welcome" aria-labelledby="welcome-title">
        <MudText Typo="Typo.h5" Class="nb-welcome-title" id="welcome-title">
            @ThaiCopy.Format("home.welcome.headline_named", ("displayName", Session.DisplayName ?? ""))
        </MudText>
        <MudText Class="nb-welcome-body">
            @ThaiCopy.T("home.welcome.body")
        </MudText>
        <img class="nb-welcome-illustration"
             src="images/home-welcome.png"
             alt="@ThaiCopy.T("home.welcome.illustration_alt")"
             width="960"
             height="540" />
        <p class="nb-welcome-tip nb-welcome-tip--desktop">@ThaiCopy.T("home.welcome.tip")</p>
        <p class="nb-welcome-tip nb-welcome-tip--mobile">@ThaiCopy.T("home.welcome.tip_mobile")</p>
    </section>
}

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
            Nav.NavigateTo("/login");
    }
}
